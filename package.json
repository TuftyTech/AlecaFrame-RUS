    "test": "node --test test/*.test.mjs",
    "preview": "node tools/preview.mjs",
    "test:windows": "pwsh -NoProfile -File test/windows.tests.ps1"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.64.0",
    "vue": "3.2.31"
  }
}
