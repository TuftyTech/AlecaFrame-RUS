{
  "name": "alecaframe-ru",
  "version": "0.2.0",
  "private": true,
  "description": "Русский интерфейс для AlecaFrame: перевод интерфейса и установщик для Windows (без изменения рекламы, подписки и функций)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "extract": "node tools/extract.mjs",
    "coverage": "node tools/coverage.mjs",
